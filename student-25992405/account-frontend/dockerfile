FROM nginx:alpine

# Remove default nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Add Account frontend nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy CSS
COPY css/ /usr/share/nginx/html/css/

# Copy Account pages
COPY templates/login.html /usr/share/nginx/html/login.html
COPY templates/register.html /usr/share/nginx/html/register.html
COPY templates/profile.html /usr/share/nginx/html/profile.html
COPY templates/preference.html /usr/share/nginx/html/preference.html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]